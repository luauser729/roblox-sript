-- ===== 数字格式化 =====
local function formatPrice(price)
    local n = tonumber(price) or 0
    if n >= 1e8 then
        return string.format("%.1f亿", n / 1e8)
    elseif n >= 1e4 then
        return string.format("%.1f万", n / 1e4)
    else
        return tostring(math.floor(n))
    end
end

