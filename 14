local function hbAllApplyOne(plr)
    if plr == LocalPlayer then return end
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not hbAllOriginals[hrp] then
        hbAllOriginals[hrp] = {
            Size = hrp.Size,
            Transparency = hrp.Transparency,
            Color = hrp.Color,
            Material = hrp.Material,
            CanCollide = hrp.CanCollide
        }
    end
    hrp.Size = Vector3.new(hbAllSize, hbAllSize, hbAllSize)
    hrp.Color = hbAllColor
    hrp.Transparency = 1 - hbAllDepth
    hrp.Material = Enum.Material.ForceField
    hrp.CanCollide = false

    local hl = hbAllHL[plr]
    if hbAllVisual then
        if not hl or not hl.Parent then
            hl = Instance.new("Highlight")
            hl.FillTransparency = 1
            hl.OutlineColor = hbAllColor
            hl.OutlineTransparency = 0
            hl.Adornee = hrp
            hl.Parent = hrp
            hbAllHL[plr] = hl
        else
            hl.OutlineColor = hbAllColor
            hl.Adornee = hrp
        end
    else
        if hl then hl:Destroy() hbAllHL[plr] = nil end
    end
end

local function hbAllApply()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            hbAllApplyOne(plr)
        end
    end
end

local function hbAllRestore()
    for hrp, d in pairs(hbAllOriginals) do
        pcall(function()
            if hrp and hrp.Parent then
                hrp.Size = d.Size
                hrp.Transparency = d.Transparency
                hrp.Color = d.Color
                hrp.Material = d.Material
                hrp.CanCollide = d.CanCollide
            end
        end)
    end
    hbAllOriginals = {}
    for _, hl in pairs(hbAllHL) do
        pcall(function() hl:Destroy() end)
    end
    hbAllHL = {}
end

local function hbAllStartLoop()
    if hbAllConn then hbAllConn:Disconnect() hbAllConn = nil end
    if not hbAllEnabled then return end
    hbAllConn = RunService.Heartbeat:Connect(function()
        pcall(function()
            if hbAllEnabled then hbAllApply() end
        end)
    end)
end

