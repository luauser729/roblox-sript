local function getRebirths()
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            local n = v.Name:lower()
            if n:find("rebirth") or n:find("reset") or n:find("重生") then
                return v.Value
            end
        end
    end
    local attr = LocalPlayer:GetAttribute("Rebirths") 
        or LocalPlayer:GetAttribute("Rebirth") 
        or LocalPlayer:GetAttribute("重生")
    if attr then return attr end
    return 0
end

local function findMyBase()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    local myName = LocalPlayer.Name
    for _, plot in ipairs(plots:GetChildren()) do
        if plot:IsA("Model") then
            if plot.Name == myName or plot.Name:find(myName, 1, true) or plot.Name:lower() == myName:lower() then
                return plot
            end
        end
