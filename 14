local function updatePlayerBoxes()
    if not playerEspEnabled then return end
    local camera = workspace.CurrentCamera
    if not camera then return end
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for plr, rec in pairs(playerTags) do
        local char = plr.Character
        local head = char and char:FindFirstChild("Head")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not head or not hrp then
            rec.frame.Visible = false
            rec.nameLabel.Visible = false
            rec.distLabel.Visible = false
        else
            local headPos = head.Position + Vector3.new(0, 0.5, 0)
            local footPos = hrp.Position - Vector3.new(0, 3, 0)
            local headScreen, headOnScreen = camera:WorldToViewportPoint(headPos)
            local footScreen, footOnScreen = camera:WorldToViewportPoint(footPos)

            if headOnScreen and footOnScreen and headScreen.Z > 0 and footScreen.Z > 0 then
                local x = headScreen.X
                local y = headScreen.Y
                local w = math.abs(headScreen.Y - footScreen.Y) * 0.6
                local h = math.abs(headScreen.Y - footScreen.Y)
                rec.frame.Position = UDim2.new(0, x - w/2, 0, y)
                rec.frame.Size = UDim2.new(0, w, 0, h)
                rec.frame.Visible = true
                rec.nameLabel.Visible = true
                rec.distLabel.Visible = true
                if myHRP then
                    local dist = (hrp.Position - myHRP.Position).Magnitude
                    rec.distLabel.Text = string.format("%.0fm", dist)
                end
            else
                rec.frame.Visible = false
                rec.nameLabel.Visible = false
                rec.distLabel.Visible = false
            end
        end
    end
end

local function scanPlayers()
    if not playerEspEnabled then
        for plr, _ in pairs(playerTags) do removePlayerBox(plr) end
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            if not playerTags[plr] then createPlayerBox(plr) end
        end
    end
    for plr, _ in pairs(playerTags) do
        if not plr.Parent or not plr.Character then removePlayerBox(plr) end
    end
end

